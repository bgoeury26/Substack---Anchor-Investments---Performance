# ── Portfolio identity ──────────────────────────────────────────────────────
PORTFOLIO_NAME=Anchor Investments
PORTFOLIO_DESCRIPTION=A fictive model portfolio published alongside my Substack.
SUBSTACK_URL=https://yoursubstack.substack.com
STARTING_CASH=100000

# ── Admin auth ───────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# Generate a bcrypt hash:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# Then paste the result below:
ADMIN_PASSWORD_HASH=$2b$12$EXAMPLE_HASH_REPLACE_ME

# ── Storage ───────────────────────────────────────────────────────────────────
# Local dev default (SQLite file, created automatically):
DATABASE_URL=sqlite:///data/portfolio.db
# Production (Streamlit Community Cloud) — point this at a hosted Postgres
# instance instead, e.g. a free Supabase project, so trade history survives
# redeploys. Example:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# ── Market data ───────────────────────────────────────────────────────────────
# "yfinance" (default, no key needed) or "openbb"
DATA_PROVIDER=yfinance
PRICE_CACHE_TTL=900
HISTORY_CACHE_TTL=3600
