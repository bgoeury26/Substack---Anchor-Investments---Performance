# .streamlit/secrets.toml — for Streamlit Community Cloud deployment.
# Paste this (with real values) into your app's
# "Settings -> Secrets" box on share.streamlit.io. Do NOT commit the real
# secrets.toml file — it's already in .gitignore.

PORTFOLIO_NAME = "Anchor Investments"
PORTFOLIO_DESCRIPTION = "A fictive model portfolio published alongside my Substack."
SUBSTACK_URL = "https://yoursubstack.substack.com"
STARTING_CASH = "100000"

ADMIN_USERNAME = "admin"
ADMIN_PASSWORD_HASH = "$2b$12$EXAMPLE_HASH_REPLACE_ME"

# Required in production — Streamlit Community Cloud wipes its own
# filesystem on every redeploy, so SQLite alone loses your trade history.
# Use a free Supabase Postgres project (see README "Deployment" section).
DATABASE_URL = "postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres"

DATA_PROVIDER = "yfinance"
PRICE_CACHE_TTL = "900"
HISTORY_CACHE_TTL = "3600"
